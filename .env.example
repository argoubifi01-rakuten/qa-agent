# Required: OpenAI API key used by the QA LLM (generator, evaluator, reporter, advisor)
OPENAI_API_KEY=sk-...

# Required: Eval mock secret — sent as X-Ninja-Eval-Mock header to bypass auth in test environments
EVAL_MOCK_SECRET=your-eval-mock-secret-here


# ---------------------------------------------------------------------------
# Database — choose ONE of the two options below
# ---------------------------------------------------------------------------

# Option A (recommended): Firestore via GCP credentials — no VPN required.
#
# Pick ONE of the sub-options below:
#
# A1 — Base64-encoded service account JSON (works anywhere, no file on disk):
#   Generate: base64 -i path/to/service-account.json | tr -d '\n'
# GCP_CREDENTIALS_BASE64=<base64-encoded service account JSON>
#
# A2 — Application Default Credentials (local dev):
#   Run once: gcloud auth application-default login
#   (No env var needed; the SDK picks up the token automatically)
#
# A3 — Service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# A4 — Workload Identity on GKE / Cloud Run (no credentials needed at all)
#
# Optionally set the GCP project if it can't be auto-detected:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Option B (legacy): MongoDB-compatible Firestore endpoint — requires VPN.
# Uncomment and fill in to use this path instead of Option A.
# MONGODB_URI=mongodb://ai-service:<password>@<project-id>.asia-northeast1.firestore.goog:443/<db>?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false

# ---------------------------------------------------------------------------

# Optional: Trace Analyser URL — when set, the generator seeds test cases from real production queries.
TRACE_ANALYSER_URL=http://localhost:8000
